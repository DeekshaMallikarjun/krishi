# KrishiAstra Environment Configuration

# Backend Configuration
PORT=8000
DATABASE_URL=sqlite:///./krishiastra.db

# Optional Groq Free Tier API Key (for LLM Chatbot)
# Get a free API key at: https://console.groq.com/
GROQ_API_KEY=your_free_groq_api_key_here

# Optional Pinecone Free Tier Vector DB (for RAG Embeddings)
# Get a free API key at: https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=gcp-starter

# Weather API (Open-Meteo is 100% FREE with no API key needed!)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Frontend API Endpoint Proxy
VITE_API_BASE_URL=http://127.0.0.1:8000
